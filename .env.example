# Voice Chat Configuration
# Copy this file to .env.local and fill in your API keys

# OpenAI API Key for voice features (Whisper + TTS)
# Get your key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (if using a proxy or alternative endpoint)
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Note: 
# - Voice features will fall back to browser's built-in speech synthesis if API key is not provided
# - Speech-to-text will fall back to backend endpoint if API key is not provided
# - Project remains lightweight and GitHub-friendly without large model files
